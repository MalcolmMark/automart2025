node_modules/

# Python virtualenv
venv/
ENV/
env/
.venv/

# Python bytecode / cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.pytest_cache/
.pytest_cache/

# Coverage / test output
.coverage
htmlcov/

# VSCode settings (optional if you don't want to commit them)
.vscode/

# Build / dist (in case you ever package)
dist/
build/
*.egg-info/




